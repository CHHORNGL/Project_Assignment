# ===============================
# FLASK
# ===============================
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-string

# ===============================
# DATABASE (PostgreSQL)
# ===============================
DB_TYPE=postgresql
DB_DRIVER=psycopg2

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=AssExpertsystem
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password

# ✅ SQLAlchemy connection string (USE THIS ONLY)
DATABASE_URL=postgresql+psycopg2://your_user:your_password@localhost:5432/AssExpertsystem

# ===============================
# SQLALCHEMY
# ===============================
SQLALCHEMY_TRACK_MODIFICATIONS=False
SQLALCHEMY_ECHO=False

# ===============================
# SECURITY
# ===============================
PASSWORD_HASH_METHOD=pbkdf2:sha256
TOKEN_EXPIRE_MINUTES=60

# ===============================
# GOOGLE OAUTH
# ===============================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ===============================
# SMTP EMAIL (GMAIL)
# ===============================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address_here@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here
MAIL_DEFAULT_SENDER=your_gmail_address_here@gmail.com

# ===============================
# YOUR SELF-TRAINED AGRICULTURAL AI
# ===============================
# This is the only supported AI provider. Point it to your protected custom
# inference service (GGUF/llama.cpp, HF Space, or compatible HTTP endpoint).
AI_PROVIDER=own-ai
HF_INFERENCE_URL=https://maoseavik-agrisystem-agricultural-assistant.hf.space
HF_TOKEN=
AI_REQUEST_TIMEOUT_SECONDS=180

# ===============================
# WEATHER INTELLIGENCE
# ===============================
WEATHER_PROVIDER_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_TTL_SECONDS=600
WEATHER_STALE_TTL_SECONDS=21600
WEATHER_REQUEST_TIMEOUT_SECONDS=6
# Optional: defaults to SESSION_REDIS_URL when SESSION_TYPE=redis.
WEATHER_REDIS_URL=

# ===============================
# DYNAMIC THEME SEASONAL EVENTS
# ===============================
THEME_EVENTS_PROVIDER=auto
THEME_EVENTS_DEFAULT_COUNTRY=KH
CALENDARIFIC_API_KEY=

# ===============================
# THEME ANIMATION AUTO SYSTEM
# ===============================
THEME_ANIMATION_CDN_PROVIDER=auto
THEME_ANIMATION_MAX_BYTES=2097152
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_UPLOAD_FOLDER=agri-theme-animations

# ===============================
# FILE UPLOADS
# ===============================
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# ===============================
# LOGGING
# ===============================
LOG_LEVEL=INFO

# ===============================
# SEED ACCOUNTS
# Required by seed_admin.py / seed_expert.py / seed_farmer.py.
# Without these three scripts abort and the database is left with no users.
# The seeders only set a password when creating a new account; they never
# reset an existing user's password. ADMIN_EMAIL / EXPERT_EMAIL are matched
# against existing users, so an unknown email creates an extra account.
# ===============================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
EXPERT_EMAIL=expert@example.com
EXPERT_PASSWORD=change-me
FARMER_PASSWORD=change-me

# ===============================
# CLOUDFLARE TUNNEL
# ===============================
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Rate limiting: memory:// is only for single-process local development.
# Docker Compose sets redis://redis:6379/0 for shared worker counters.
RATELIMIT_STORAGE_URI=memory://
RATE_LIMIT_GLOBAL=300 per minute;3000 per hour
RATE_LIMIT_AUTH=10 per minute;100 per hour
RATE_LIMIT_RECOVERY=5 per minute;20 per hour
RATE_LIMIT_EXPENSIVE=30 per minute;300 per hour
# 0 for direct local access. Compose sets 1 for its trusted Cloudflare Tunnel.
TRUSTED_PROXY_COUNT=0
# Maximum Flask request body, in bytes (16 MiB); includes multipart uploads.
MAX_CONTENT_LENGTH=16777216

# Server-side sessions: local development uses private instance/sessions files.
# Docker Compose overrides these with Redis on database 1.
SESSION_TYPE=cachelib
SESSION_REDIS_URL=redis://localhost:6379/1
SESSION_IDLE_TIMEOUT_SECONDS=1296000
SESSION_ABSOLUTE_TIMEOUT_SECONDS=1296000
SESSION_COOKIE_SECURE=true
# Existing cross-site frontend requires None + HTTPS. Use Lax for same-site hosting.
SESSION_COOKIE_SAMESITE=None
